# ============================================
# Git Configuration & Sensitive Files
# ============================================
# Arquivos de configuração Git com dados sensíveis
# NOTA: .git/config contém user.name e user.email locais
#       que são específicos do ambiente - não deve ser commitado
#       Mas como é necessário para o Git funcionar, mantenha localmente
.git/config.local
.git/config.backup*
.git/config.old
.git/config.work
.git/credentials
.git/worktrees/
.git/refs/original/
.git/hooks/*.sample
.git/info/exclude

# SSH Keys e configurações sensíveis
.ssh/id_*
.ssh/config.local
.ssh/config.backup*
.ssh/*.pem
.ssh/*.key
.ssh/known_hosts

# ============================================
# Scripts Temporários de Configuração
# ============================================
# Diretório completo com scripts de manutenção Git/SSH
maintenance_devops/*
scripts/*

