# Strato Quantum AI Agents - Environment Variables v2.6.3

# Application
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql://stratoquantum:stratoquantum2025@localhost:5432/stratoquantum
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=stratoquantum2025

# Security
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Models
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-3.5-turbo

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
SENTRY_DSN=your-sentry-dsn-here

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Agent Configuration
AGENT_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=100
AGENT_MEMORY_SIZE=10

# WebSocket
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_TIMEOUT=60

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Production Settings (for AWS deployment)
POSTGRES_PASSWORD=stratoquantum2025
GRAFANA_PASSWORD=admin