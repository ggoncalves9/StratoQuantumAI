# ============================================
# StratoQuantum AI Agents - Environment Variables
# ============================================
# Copy this file to .env and fill with your actual values

# ============================================
# APPLICATION SETTINGS
# ============================================
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
WORKERS=4
APP_NAME=StratoQuantum Agents
APP_VERSION=2.6.8

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://stratoquantum:stratoquantum2025@localhost:5432/stratoquantum
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=stratoquantum
DATABASE_USER=stratoquantum
DATABASE_PASSWORD=stratoquantum2025
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_SSL=false

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=stratoquantum2025
REDIS_DB=1

# ============================================
# SECURITY
# ============================================
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY=your-agents-api-key-for-platform-communication

# ============================================
# AI MODELS CONFIGURATION
# ============================================
# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Local AI (Ollama/LM Studio)
LOCAL_AI_URL=http://localhost:11434
LOCAL_AI_MODEL=deepseek-coder
LOCAL_AI_ENABLED=false

# Model Provider Selection
MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-4
FALLBACK_MODEL=gpt-3.5-turbo

# ============================================
# AGENT CONFIGURATION
# ============================================
AGENT_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=100
AGENT_MEMORY_SIZE=10
AGENT_MAX_RETRIES=3
AGENT_RESPONSE_TIMEOUT=60

# CrewAI Configuration
CREW_MAX_AGENTS=7
CREW_EXECUTION_TIMEOUT=300
CREW_MEMORY_ENABLED=true

# ============================================
# PLATFORM INTEGRATION
# ============================================
PLATFORM_API_URL=http://localhost:3000
PLATFORM_API_KEY=your-platform-api-key
PLATFORM_WEBHOOK_SECRET=your-webhook-secret

# ============================================
# WEBSOCKET CONFIGURATION
# ============================================
WEBSOCKET_ENABLED=true
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_TIMEOUT=60
WEBSOCKET_MAX_CONNECTIONS=500

# ============================================
# CORS & SECURITY
# ============================================
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:5500"]
ALLOWED_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_CREDENTIALS=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_SKIP_SUCCESSFUL=true

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/agents.log

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9091
SENTRY_DSN=your-sentry-dsn-here

# ============================================
# EXTERNAL SERVICES
# ============================================
# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Email Service (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ============================================
# AGENT SPECIALIZATIONS
# ============================================
# Financial Agent
FINANCIAL_AGENT_ENABLED=true
FINANCIAL_API_ENDPOINTS=["https://api.example.com/financial"]

# HR Agent
HR_AGENT_ENABLED=true
HR_INTEGRATIONS=["workday","bamboohr"]

# Technology Agent
TECH_AGENT_ENABLED=true
TECH_MONITORING_APIS=["datadog","newrelic"]

# Operations Agent
OPS_AGENT_ENABLED=true
OPS_TOOLS=["kubernetes","docker","terraform"]

# Commercial Agent
COMMERCIAL_AGENT_ENABLED=true
CRM_INTEGRATIONS=["salesforce","hubspot"]

# Product Agent
PRODUCT_AGENT_ENABLED=true
PRODUCT_TOOLS=["jira","linear","notion"]

# Marketing Agent
MARKETING_AGENT_ENABLED=true
MARKETING_APIS=["google-analytics","facebook-ads"]

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
HOT_RELOAD=true
AUTO_RELOAD=true
DEBUG_AGENTS=true

# ============================================
# PRODUCTION OVERRIDES
# ============================================
# Uncomment for production deployment
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=WARNING
# DATABASE_SSL=true
# REDIS_TLS=true