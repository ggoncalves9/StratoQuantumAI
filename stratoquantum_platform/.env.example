# ============================================
# StratoQuantum Platform - Environment Variables
# ============================================
# Copy this file to .env and fill with your actual values

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=development
PORT=3000
HOST=localhost
APP_NAME=StratoQuantum Platform
APP_VERSION=2.6.8

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://stratoquantum:stratoquantum2025@localhost:5432/stratoquantum
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=stratoquantum
DATABASE_USER=stratoquantum
DATABASE_PASSWORD=stratoquantum2025
DATABASE_POOL_SIZE=20
DATABASE_SSL=false

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=stratoquantum2025
REDIS_DB=0

# ============================================
# SECURITY
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=your-session-secret-key-change-in-production
BCRYPT_ROUNDS=12

# ============================================
# CORS & SECURITY
# ============================================
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:5500"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# AI AGENTS INTEGRATION
# ============================================
AGENTS_API_URL=http://localhost:8000
AGENTS_API_KEY=your-agents-api-key
AGENTS_TIMEOUT=30000

# ============================================
# WEBSOCKET
# ============================================
WEBSOCKET_PORT=3001
WEBSOCKET_ENABLED=true

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/platform.log

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=["jpg","jpeg","png","pdf","doc","docx"]

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@stratoquantum.com

# ============================================
# MONITORING
# ============================================
ENABLE_METRICS=true
SENTRY_DSN=your-sentry-dsn-here
HEALTH_CHECK_INTERVAL=30