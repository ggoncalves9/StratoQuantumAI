# ============================================
# StratoQuantum - Docker Environment Variables
# ============================================
# Copy this file to .env for Docker Compose usage
# These variables are used by docker-compose.yml

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=production
ENVIRONMENT=production
DEBUG=false

# ============================================
# PLATFORM CONFIGURATION
# ============================================
PLATFORM_HOST=0.0.0.0
PLATFORM_PORT=3000
PLATFORM_API_URL=http://app:3000

# ============================================
# AI AGENTS CONFIGURATION
# ============================================
AGENTS_HOST=0.0.0.0
AGENTS_PORT=8000
AGENTS_WORKERS=4
AGENTS_API_URL=http://agents:8000

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=stratoquantum
DATABASE_USER=stratoquantum
DATABASE_PASSWORD=stratoquantum2025_change_in_production

# PostgreSQL Admin Password
POSTGRES_PASSWORD=stratoquantum2025_change_in_production

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=stratoquantum2025_change_in_production
REDIS_DB=0

# ============================================
# SECURITY SECRETS
# ============================================
# Generate these with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
SESSION_SECRET=your-session-secret-key-change-in-production
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# API Keys for inter-service communication
AGENTS_API_KEY=your-agents-api-key-change-in-production
PLATFORM_API_KEY=your-platform-api-key-change-in-production

# ============================================
# AI MODELS CONFIGURATION
# ============================================
# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model Configuration
MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-4
FALLBACK_MODEL=gpt-3.5-turbo

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info
ENABLE_METRICS=true

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn-here

# ============================================
# MONITORING (Optional)
# ============================================
# Grafana Admin Password
GRAFANA_PASSWORD=admin_change_in_production

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@stratoquantum.com

# ============================================
# AWS CONFIGURATION (Optional)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=stratoquantum-files

# ============================================
# PRODUCTION OVERRIDES
# ============================================
# Uncomment and modify for production deployment
# PLATFORM_URL=https://app.stratoquantum.com
# AGENTS_URL=https://agents.stratoquantum.com
# DATABASE_SSL=true
# REDIS_TLS=true