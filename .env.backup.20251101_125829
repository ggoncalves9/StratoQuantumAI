# ============================================
# StratoQuantum - Environment Variables Template
# ============================================
# Copy this file to .env and fill with your actual values
# NEVER commit .env files to version control

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=development
APP_NAME=StratoQuantum
APP_VERSION=2.6.8
DEBUG=true

# ============================================
# PLATFORM BACKEND (Node.js/Express)
# ============================================
# Server Configuration
PLATFORM_HOST=localhost
PLATFORM_PORT=3000
PLATFORM_URL=http://localhost:3000

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Session
SESSION_SECRET=your-session-secret-key-change-in-production
SESSION_MAX_AGE=86400000

# ============================================
# AI AGENTS BACKEND (Python/FastAPI)
# ============================================
# Server Configuration
AGENTS_HOST=localhost
AGENTS_PORT=8000
AGENTS_URL=http://localhost:8000
AGENTS_WORKERS=4

# Agent Configuration
AGENT_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=100
AGENT_MEMORY_SIZE=10
AGENT_MAX_RETRIES=3

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL (Primary Database)
DATABASE_URL=postgresql://stratoquantum:stratoquantum2025@localhost:5432/stratoquantum
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=stratoquantum
DATABASE_USER=stratoquantum
DATABASE_PASSWORD=stratoquantum2025
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_SSL=false

# MongoDB (Document Store - Optional)
MONGODB_URL=mongodb://localhost:27017/stratoquantum
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=stratoquantum
MONGODB_USER=stratoquantum
MONGODB_PASSWORD=stratoquantum2025

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=stratoquantum2025
REDIS_DB=0
REDIS_MAX_CONNECTIONS=100

# ============================================
# AI MODELS & APIs
# ============================================
# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Local AI (Ollama/LM Studio)
LOCAL_AI_URL=http://localhost:11434
LOCAL_AI_MODEL=deepseek-coder
LOCAL_AI_ENABLED=false

# Model Configuration
MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-4
FALLBACK_MODEL=gpt-3.5-turbo

# ============================================
# EXTERNAL SERVICES
# ============================================
# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@stratoquantum.com

# File Storage
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads
MAX_FILE_SIZE=10485760

# AWS S3 (if using cloud storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=stratoquantum-files

# ============================================
# SECURITY & CORS
# ============================================
# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:5500"]
ALLOWED_METHODS=["GET","POST","PUT","DELETE","PATCH","OPTIONS"]
ALLOWED_HEADERS=["Content-Type","Authorization","X-Requested-With"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_SKIP_SUCCESSFUL=true

# Security Headers
HELMET_ENABLED=true
CSP_ENABLED=true

# ============================================
# WEBSOCKET CONFIGURATION
# ============================================
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=3001
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_TIMEOUT=60
WEBSOCKET_MAX_CONNECTIONS=1000

# ============================================
# LOGGING & MONITORING
# ============================================
# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=development

# ============================================
# DOCKER & KUBERNETES
# ============================================
# Docker Configuration
DOCKER_REGISTRY=docker.io
DOCKER_NAMESPACE=stratoquantum
DOCKER_TAG=latest

# Kubernetes
K8S_NAMESPACE=stratoquantum
K8S_CLUSTER_NAME=stratoquantum-cluster

# ============================================
# DEVELOPMENT TOOLS
# ============================================
# Hot Reload
HOT_RELOAD=true
WATCH_FILES=true

# API Documentation
API_DOCS_ENABLED=true
API_DOCS_PATH=/api/docs

# Debug Tools
ENABLE_PROFILER=false
ENABLE_DEBUGGER=false

# ============================================
# PRODUCTION OVERRIDES
# ============================================
# These will be used in production environment
# PLATFORM_URL=https://app.stratoquantum.com
# AGENTS_URL=https://agents.stratoquantum.com
# DATABASE_SSL=true
# REDIS_TLS=true
# LOG_LEVEL=warn
# DEBUG=false
# ENABLE_METRICS=true
# SENTRY_ENVIRONMENT=production

# ============================================
# BACKUP & MAINTENANCE
# ============================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=stratoquantum-backups

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System under maintenance. Please try again later.